{
  "name": "scan_drive_assets",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "v1/scan_drive_assets",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "2",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const body=$json.body??$json;const headers=$json.headers??{};const rawJobId=String(body.job_id||$json.job_id||'');const jobId=/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/.test(rawJobId)?rawJobId:'';return [{json:{...body,job_id:jobId,mode:body.mode||'live',agent_secret:headers['x-agent-secret']||headers['X-Agent-Secret']||''}}];"
      }
    },
    {
      "id": "3",
      "name": "Check Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.agent_secret}}",
              "operation": "equal",
              "value2": "={{$env.AGENT_WEBHOOK_SECRET}}"
            }
          ]
        }
      }
    },
    {
      "id": "4",
      "name": "Reject Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        660,
        -180
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":false,\"error\":\"unauthorized\"}",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "5",
      "name": "Load Job",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT id::text AS job_id, drive_root_folder_id FROM content_jobs WHERE id=NULLIF('{{$json.job_id}}','')::uuid;"
      }
    },
    {
      "id": "6",
      "name": "List Drive Files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{'https://www.googleapis.com/drive/v3/files?q=' + encodeURIComponent(''' + $json.drive_root_folder_id + ''' + ' in parents and trashed=false') + '&fields=files(id,name,mimeType,size)'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.GOOGLE_DRIVE_ACCESS_TOKEN}}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "7",
      "name": "Build Asset Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const jobId=$node['Load Job'].json.job_id;const files=$json.files||[];return files.map(f=>({json:{job_id:jobId,drive_file_id:f.id,file_name:String(f.name||'unnamed').replace(/'/g,\"''\"),mime_type:f.mimeType||'',file_size_bytes:f.size||null,source_type:'drive_file'}}));"
      }
    },
    {
      "id": "8",
      "name": "Register Asset",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=WITH inserted AS (INSERT INTO content_assets (job_id,source_type,drive_file_id,file_name,mime_type,file_size_bytes,parse_status,extracted_metadata) VALUES (NULLIF('{{$json.job_id}}','')::uuid,'{{$json.source_type}}','{{$json.drive_file_id}}','{{$json.file_name}}','{{$json.mime_type}}',NULLIF('{{$json.file_size_bytes || \"\"}}','')::bigint,'queued',jsonb_build_object('source','google_drive_list','credential','GOOGLE_DRIVE_AI_CONTENT')) RETURNING id,job_id), event_insert AS (INSERT INTO content_events (job_id,event_type,message,metadata) SELECT job_id,'drive_asset_registered','Drive asset registered',jsonb_build_object('asset_id',id) FROM inserted) SELECT id::text AS asset_id FROM inserted;"
      }
    },
    {
      "id": "9",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true,\"workflow\":\"scan_drive_assets\",\"asset_id\":\"{{$json.asset_id || ''}}\"}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Normalize Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Input": {
      "main": [
        [
          {
            "node": "Check Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Secret": {
      "main": [
        [
          {
            "node": "Load Job",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject Unauthorized",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Job": {
      "main": [
        [
          {
            "node": "List Drive Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Drive Files": {
      "main": [
        [
          {
            "node": "Build Asset Rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Asset Rows": {
      "main": [
        [
          {
            "node": "Register Asset",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Register Asset": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "v1.0-rc-pre-n8n-drive"
}
