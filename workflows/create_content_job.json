{
  "name": "create_content_job",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "v1/create_content_job",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "2",
      "name": "Extract",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        200,
        0
      ],
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            {
              "name": "job_id",
              "value": "={{$json.body.job_id || $json.job_id || ''}}"
            },
            {
              "name": "agent_secret",
              "value": "={{$json.headers['x-agent-secret'] || ''}}"
            }
          ]
        }
      }
    },
    {
      "id": "3",
      "name": "Auth",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        400,
        0
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.agent_secret}}",
              "operation": "equal",
              "value2": "={{$env.AGENT_WEBHOOK_SECRET}}"
            }
          ]
        }
      }
    },
    {
      "id": "4",
      "name": "401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        600,
        -120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":false,\"error\":\"unauthorized\"}",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "5",
      "name": "Task Start",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        600,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO content_tasks (job_id,task_type,task_key,status,input_payload) SELECT NULLIF('{{$json.job_id}}','')::uuid,'workflow','create_content_job','running','{{ JSON.stringify($json.body || $json) }}'::jsonb WHERE NULLIF('{{$json.job_id}}','') IS NOT NULL ON CONFLICT (job_id,task_key) DO UPDATE SET status='running',updated_at=now();"
      }
    },
    {
      "id": "6",
      "name": "Do Work",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        820,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=WITH cp AS (\nINSERT INTO client_profiles (client_code,client_name)\nSELECT NULLIF('{{$json.body.client_code || \"\"}}',''), COALESCE(NULLIF('{{$json.body.client_name || \"\"}}',''),'Unknown Client')\nWHERE NULLIF('{{$json.body.client_code || \"\"}}','') IS NOT NULL\nON CONFLICT (client_code) DO UPDATE SET client_name=EXCLUDED.client_name\nRETURNING id), j AS (\nINSERT INTO content_jobs (external_job_ref,client_profile_id,project_name,brief_text,requested_outputs,status,created_by)\nVALUES (NULLIF('{{$json.body.external_job_ref || \"\"}}',''),(SELECT id FROM cp LIMIT 1),NULLIF('{{$json.body.project_name || \"\"}}',''),NULLIF('{{$json.body.brief_text || \"\"}}',''),COALESCE('{{ JSON.stringify($json.body.requested_outputs || []) }}'::jsonb,'[]'::jsonb),CASE WHEN NULLIF('{{$json.body.project_name || \"\"}}','') IS NOT NULL AND NULLIF('{{$json.body.brief_text || \"\"}}','') IS NOT NULL THEN 'intake_complete'::job_status ELSE 'created'::job_status END,NULLIF('{{$json.body.created_by || \"\"}}','')) RETURNING id,status)\nINSERT INTO content_tasks (job_id,task_type,task_key,status,input_payload)\nSELECT id,'intake','intake','completed','{{ JSON.stringify($json.body || {}) }}'::jsonb FROM j\nRETURNING job_id;"
      }
    },
    {
      "id": "7",
      "name": "Log Event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO content_events (job_id,event_type,message,metadata) SELECT NULLIF('{{$json.job_id || $json.body.job_id || }}','')::uuid,'workflow_completed','create_content_job complete',jsonb_build_object('workflow','create_content_job');"
      }
    },
    {
      "id": "8",
      "name": "200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1260,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true,\"workflow\":\"create_content_job\",\"job_id\":\"{{$json.job_id || $json.body.job_id || ''}}\"}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Extract",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract": {
      "main": [
        [
          {
            "node": "Auth",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auth": {
      "main": [
        [
          {
            "node": "Task Start",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "401",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Task Start": {
      "main": [
        [
          {
            "node": "Do Work",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Do Work": {
      "main": [
        [
          {
            "node": "Log Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Event": {
      "main": [
        [
          {
            "node": "200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "v1.0-rc-impl"
}