{
  "name": "notify_user_for_review",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "v1/notify_user_for_review",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "2",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            {
              "name": "workflow_name",
              "value": "notify_user_for_review"
            },
            {
              "name": "job_id",
              "value": "={{$json.body.job_id || $json.job_id || ''}}"
            },
            {
              "name": "agent_secret",
              "value": "={{$json.headers['x-agent-secret'] || $json.headers['X-Agent-Secret'] || ''}}"
            }
          ],
          "boolean": [
            {
              "name": "is_agent_api",
              "value": "={{$json.path && $json.path.includes('/api_')}}"
            }
          ]
        }
      }
    },
    {
      "id": "3",
      "name": "Check Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.agent_secret}}",
              "operation": "equal",
              "value2": "={{$env.AGENT_WEBHOOK_SECRET || 'CHANGE_ME'}}"
            }
          ]
        }
      }
    },
    {
      "id": "4",
      "name": "Reject Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        660,
        -120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":false,\"error\":\"unauthorized\",\"workflow\":\"notify_user_for_review\"}",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "5",
      "name": "Ensure Task",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        660,
        20
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO content_tasks (job_id, task_type, task_key, status, input_payload)\nSELECT NULLIF('{{$json.job_id}}','')::uuid, 'workflow', 'notify_user_for_review', 'running', '{{ JSON.stringify($json.body || $json) }}'::jsonb\nWHERE NULLIF('{{$json.job_id}}','') IS NOT NULL\nON CONFLICT (job_id, task_key) DO UPDATE SET status='running', updated_at=now();"
      }
    },
    {
      "id": "6",
      "name": "Log Event Start",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        880,
        20
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO content_events (job_id,event_type,message,metadata)\nSELECT NULLIF('{{$json.job_id}}','')::uuid, 'workflow_started', 'Workflow started: notify_user_for_review', jsonb_build_object('workflow','notify_user_for_review')\nWHERE NULLIF('{{$json.job_id}}','') IS NOT NULL;"
      }
    },
    {
      "id": "7",
      "name": "Gate Check",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1100,
        20
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT 1;"
      }
    },
    {
      "id": "8",
      "name": "Allowed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1320,
        20
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json[0] && $json[0].allowed !== undefined ? $json[0].allowed : 1}}",
              "operation": "equal",
              "value2": 1
            }
          ]
        }
      }
    },
    {
      "id": "9",
      "name": "Gate Fail Log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1540,
        -80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO content_errors (job_id,severity,error_code,error_message,recoverable,context)\nSELECT NULLIF('{{$json.job_id}}','')::uuid,'high','APPROVAL_GATE_BLOCK','Approval gate blocked workflow notify_user_for_review',true,jsonb_build_object('workflow','notify_user_for_review')\nWHERE NULLIF('{{$json.job_id}}','') IS NOT NULL;"
      }
    },
    {
      "id": "10",
      "name": "Gate Fail Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1760,
        -80
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":false,\"error\":\"approval_gate_blocked\",\"workflow\":\"notify_user_for_review\"}",
        "options": {
          "responseCode": 409
        }
      }
    },
    {
      "id": "11",
      "name": "Main DB Action",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1540,
        80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO content_events (job_id,event_type,message,metadata)\nSELECT NULLIF('{{$json.job_id}}','')::uuid, 'workflow_action', 'Executed notify_user_for_review', jsonb_build_object('workflow','notify_user_for_review','note','template action')\nWHERE NULLIF('{{$json.job_id}}','') IS NOT NULL;"
      }
    },
    {
      "id": "12",
      "name": "Complete Task",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1760,
        80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE content_tasks SET status='completed', updated_at=now() WHERE job_id=NULLIF('{{$json.job_id}}','')::uuid AND task_key='notify_user_for_review';"
      }
    },
    {
      "id": "13",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1980,
        80
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true,\"workflow\":\"notify_user_for_review\",\"job_id\":\"{{$json.job_id}}\"}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
