{
  "name": "api_supervisor_gateway",
  "id": "api_supervisor_gateway",
  "active": false,
  "nodes": [
    {
      "id": "1",
      "name": "Supervisor API Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "v1/supervisor",
        "responseMode": "lastNode",
        "authentication": "headerAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "AI_AGENT_WEBHOOK_AUTH",
          "name": "AI_AGENT_WEBHOOK_AUTH"
        }
      }
    },
    {
      "id": "2",
      "name": "Enforce Agent Safety Boundaries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const body = $json.body ?? {};\nconst action = body.action || 'check_status';\nconst forbidden = ['delete_files','delete_file','publish_content','publish','send_final','send_final_client_deliverables','change_credentials','modify_schema','modify_database_schema','edit_workflows','edit_n8n_workflows','approve_analysis','approve_plan','approve_final_delivery'];\nif (forbidden.includes(action)) {\n  throw new Error('Action is forbidden for agents or requires the human review gateway');\n}\nconst route_to_orchestrator = !['check_status','list_active_jobs'].includes(action);\nreturn [{json: {...body, action, route_to_orchestrator, allowed_actions: ['create_job','submit_message','attach_drive_folder','check_status','list_active_jobs','progress_update','error_report','request_revision','retry','pause','resume','cancel','generate_outputs','qa_delivery']}}];"
      }
    },
    {
      "id": "3a",
      "name": "Needs Orchestrator",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        330,
        40
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.route_to_orchestrator}}",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "3",
      "name": "Route To Orchestrator",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        440,
        -80
      ],
      "parameters": {
        "workflowId": "ai_content_orchestrator",
        "options": {
          "waitForSubWorkflow": true
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "job_id": "={{$json.job_id}}",
            "action": "={{$json.action}}",
            "mode": "={{$json.mode || 'dry_run'}}",
            "payload": "={{$json}}",
            "desired_tools": "={{$json.desired_tools}}",
            "tool_results": "={{$json.tool_results}}",
            "current_stage": "={{$json.current_stage}}",
            "status": "={{$json.status}}",
            "error": "={{$json.error}}"
          }
        }
      }
    },
    {
      "id": "4",
      "name": "Status Query",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id::text AS job_id, status::text, updated_at, project_name, drive_root_folder_id,\n  (SELECT count(*) FROM content_tasks WHERE job_id=content_jobs.id AND status NOT IN ('completed','cancelled')) AS active_task_count,\n  (SELECT count(*) FROM content_outputs WHERE job_id=content_jobs.id) AS output_count,\n  (SELECT count(*) FROM content_errors WHERE job_id=content_jobs.id AND resolved_at IS NULL) AS open_error_count\nFROM content_jobs\nWHERE ('{{$json.action}}'='list_active_jobs' AND status NOT IN ('delivery_ready','completed','cancelled','failed'))\n   OR id=NULLIF('{{$json.job_id}}','')::uuid\nORDER BY updated_at DESC\nLIMIT CASE WHEN '{{$json.action}}'='list_active_jobs' THEN 25 ELSE 1 END;"
      },
      "credentials": {
        "postgres": {
          "id": "POSTGRES_AI_CONTENT_DB",
          "name": "POSTGRES_AI_CONTENT_DB"
        }
      }
    },
    {
      "id": "5",
      "name": "Return Supervisor Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "responseBody": "={{$json}}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Supervisor API Webhook": {
      "main": [
        [
          {
            "node": "Enforce Agent Safety Boundaries",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enforce Agent Safety Boundaries": {
      "main": [
        [
          {
            "node": "Needs Orchestrator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs Orchestrator": {
      "main": [
        [
          {
            "node": "Route To Orchestrator",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Status Query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route To Orchestrator": {
      "main": [
        [
          {
            "node": "Return Supervisor Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Status Query": {
      "main": [
        [
          {
            "node": "Return Supervisor Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "operator-ready-v2-repaired"
}
