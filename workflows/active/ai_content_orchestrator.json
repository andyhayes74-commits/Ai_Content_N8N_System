        "jsCode": "const body = $json.body ?? $json;\nconst action = body.action || 'run_lifecycle';\nconst routes = {\n  run_lifecycle: ['tool_job_intake','tool_drive_assets','tool_request_analysis'],\n  dry_run_full_lifecycle: ['tool_job_intake','tool_drive_assets','tool_request_analysis','tool_content_planning','tool_content_generation','tool_qa_delivery'],\n  create_job: ['tool_job_intake','tool_drive_assets','tool_request_analysis'],\n  attach_drive_folder: ['tool_job_intake','tool_drive_assets'],\n  analyse_request: ['tool_request_analysis'],\n  generate_plan: ['tool_content_planning'],\n  generate_outputs: ['tool_content_generation'],\n  qa_delivery: ['tool_qa_delivery'],\n  log_progress: ['tool_logging'],\n  report_error: ['tool_logging'],\n  retry: ['tool_logging'],\n  pause: ['tool_logging'],\n  resume: ['tool_logging'],\n  cancel: ['tool_logging']\n};\nconst desired = routes[action] || routes.run_lifecycle;\nconst lifecycle = ['intake','drive_assets','request_analysis','analysis_approval_gate','content_planning','plan_approval_gate','content_generation','qa_delivery','final_approval_gate','delivery_pack'];\nreturn [{json: {...body, action, mode: body.mode || 'dry_run', desired_tools: desired, lifecycle, current_stage: 'orchestrator_start', payload: body.payload || body, tool_results: [], status: 'orchestrating'}}];"
      }
