        "repair_invalid_json",
        "repair_missing_fields",
        "repair_tone_mismatch",
        "remove_unsupported_claims",
        "repair_formatting",
        "repair_length_limits"
      ],
      "input_contract": {
        "job_id": "uuid",
        "output_id": "uuid optional",
        "issue": "object",
        "max_repair_attempts": "integer optional",
        "mode": "dry_run|live"
      },
      "output_contract": {
        "job_id": "uuid",
        "output_id": "uuid optional",
        "status": "repaired|queued|requires_human",
